# Unity YAML remains diffable; preserve LF in repository text.
* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text=auto
*.mat text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf

# Editable sources and binary art use Git LFS from the first commit.
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
